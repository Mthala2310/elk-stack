# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# SQLite dari Incident Worker (dibaca read-only)
INCIDENT_DB_PATH=../incident-worker/data/incidents.sqlite3

# SQLite khusus status pengiriman Telegram
NOTIFICATION_DB_PATH=state/notifications.sqlite3

# Periksa event baru setiap 10 detik
NOTIFICATION_POLL_SECONDS=10

# Retry untuk kegagalan yang aman dicoba ulang
NOTIFICATION_RETRY_SECONDS=60
NOTIFICATION_MAX_ATTEMPTS=5

