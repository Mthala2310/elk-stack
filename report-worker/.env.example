# Index yang dilaporkan
REPORT_INDEX=app-logs-*

# Zona waktu laporan
REPORT_TIMEZONE=Asia/Jakarta

# Worker memeriksa setiap 180 detik apakah jam laporan berikutnya sudah selesai
REPORT_POLL_SECONDS=180

# Database untuk menyimpan hasil laporan
REPORT_DB_PATH=state/reports.sqlite3

# Ganti dengan link asli dashboard dari menu Share -> Link -> Copy link di Kibana
KIBANA_DASHBOARD_URL="http://localhost:5601/app/dashboards#/view/<your-dashboard-id>"

# Folder hasil screenshot
REPORT_SCREENSHOT_DIR=state/screenshots

# =====================================
# TELEGRAM HOURLY REPORT
# =====================================
REPORT_INCLUDE_ENDPOINT_PATHS=true
REPORT_SEND_SCREENSHOT=true
REPORT_TELEGRAM_RETRY_SECONDS=90
REPORT_TELEGRAM_MAX_ATTEMPTS=5

